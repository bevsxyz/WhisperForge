# Maintainer: Bevan Stanely <bevan.stanely@accenture.com>
pkgname=whisperforge-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Fast GPU-accelerated speech-to-text CLI with streaming, quantization, speaker diarization, and multilingual support"
arch=('x86_64' 'aarch64')
url="https://github.com/bevsxyz/WhisperForge"
license=('MIT')
depends=('alsa-lib' 'gcc-libs')
provides=('whisperforge')
conflicts=('whisperforge')

source_x86_64=("whisperforge-x86_64-unknown-linux-gnu.tar.xz::https://github.com/bevsxyz/WhisperForge/releases/download/v${pkgver}/whisperforge-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("whisperforge-aarch64-unknown-linux-gnu.tar.xz::https://github.com/bevsxyz/WhisperForge/releases/download/v${pkgver}/whisperforge-aarch64-unknown-linux-gnu.tar.xz")

# Checksums are skipped; populate via 'updpkgsums' or release CI automation before publishing
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 wforge "$pkgdir/usr/bin/wforge"
  install -Dm755 wf "$pkgdir/usr/bin/wf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
